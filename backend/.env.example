# Puerto del backend (Render/Railway asigna uno automaticamente, deja 4000 para local)
PORT=4000

# Origenes permitidos para CORS (separados por coma, sin barra final)
#
# LOCAL:      http://localhost:3000
# PRODUCCION: tu URL de Cloudflare Pages, ejemplo:
#             https://gestor-reportes.pages.dev
#
# Puedes poner ambos separados por coma para que funcione en ambos entornos.
FRONTEND_ORIGINS=http://localhost:3000,https://gestor-reportes.pages.dev

# Proxies de confianza (1 = Cloudflare/Render, true = todos)
TRUST_PROXY=1

# Rate limit: ventana en ms y maximo de solicitudes por IP en esa ventana
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=120

# Limite maximo de archivos subidos en MB
MAX_UPLOAD_MB=25
